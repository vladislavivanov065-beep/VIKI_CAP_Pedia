DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Публикуете через ngrok (или любой другой туннель/прокси на своём домене)?
# Добавьте его домен сюда — иначе Django отвечает 400 Bad Request на все
# запросы. Домен ngrok меняется при каждом перезапуске, поэтому проще
# один раз указать маску поддомена (у ngrok их несколько — ngrok-free.app
# и ngrok-free.dev — смотрите, какой именно у вас в адресной строке):
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok-free.dev
# Аналогично для отправки форм (например, входа) нужен доверенный источник:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok-free.dev
DJANGO_CSRF_TRUSTED_ORIGINS=

SQLITE_PATH=/app/data/db.sqlite3
BACKUP_DIR=/app/data/backups

SITE_NAME=Corporate Wiki
SITE_URL=http://localhost:8000

MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_ATTACHMENT_SIZE_MB=20

# "Задай свой вопрос" на странице статьи — отвечает на основе текста
# текущей статьи через OpenAI (запрос уходит только когда действительно
# задан вопрос). Не задан — раздел просто сообщит, что не настроен.
# Перед отправкой в OpenAI текст статьи анонимизируется (см.
# apps.assistant.redaction) — числа, ссылки, адреса и страны заменяются на
# [XXXn], а после ответа реальные значения подставляются обратно. То же
# самое применяется, когда OpenAI используется для разбивки статьи на
# фрагменты при обучении локального ИИ (apps.assistant.chunking_remote).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Через запятую — точные названия/термины, которые нужно всегда скрывать
# дополнительно к автоматически распознаваемым (например, название вашего
# карточного/платёжного партнёра, которое иначе не отличить от обычного
# названия поддерживаемого мерчанта).
LOCAL_AI_REDACTED_TERMS=

# Локальный ИИ (без OpenAI) — находит самое релевантное предложение по
# статьям через небольшую модель эмбеддингов, которая работает полностью на
# этом сервере. Веса скачиваются один раз с Hugging Face при первом обучении
# и кэшируются в LOCAL_AI_MODEL_CACHE_DIR (пусто — стандартный кэш
# huggingface в HOME).
LOCAL_AI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Дополнительно переранжирует несколько лучших кандидатов от модели
# эмбеддингов — тоже скачивается один раз, при первом вопросе после
# обучения.
LOCAL_AI_CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
LOCAL_AI_MODEL_CACHE_DIR=

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

GUNICORN_WORKERS=1
GUNICORN_THREADS=4

ADMIN_USERNAME=admin
ADMIN_TEMP_PASSWORD=change-me-1234
