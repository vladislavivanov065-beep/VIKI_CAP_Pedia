DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=

SQLITE_PATH=/app/data/db.sqlite3
BACKUP_DIR=/app/data/backups

SITE_NAME=Corporate Wiki
SITE_URL=http://localhost:8000

MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_ATTACHMENT_SIZE_MB=20

# "Задай свой вопрос" на странице статьи — отвечает на основе текста
# текущей статьи через OpenAI (запрос уходит только когда действительно
# задан вопрос). Не задан — раздел просто сообщит, что не настроен.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Локальный ИИ (без OpenAI) — находит самое релевантное предложение по
# статьям через небольшую модель эмбеддингов, которая работает полностью на
# этом сервере. Веса скачиваются один раз с Hugging Face при первом обучении
# и кэшируются в LOCAL_AI_MODEL_CACHE_DIR (пусто — стандартный кэш
# huggingface в HOME).
LOCAL_AI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
LOCAL_AI_MODEL_CACHE_DIR=

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

GUNICORN_WORKERS=1
GUNICORN_THREADS=4

ADMIN_USERNAME=admin
ADMIN_TEMP_PASSWORD=change-me-1234
