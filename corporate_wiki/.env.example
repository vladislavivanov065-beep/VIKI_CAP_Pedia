DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

SQLITE_PATH=/app/data/db.sqlite3
# Куда manage.py backup_database складывает резервные копии (см. Этап 11).
BACKUP_DIR=/app/data/backups

# Название и брендинг базы знаний — задаётся здесь, а не в коде/шаблонах.
SITE_NAME=Corporate Wiki
SITE_URL=http://localhost:8000

MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# Используются только командой create_initial_admin (см. Этап 2).
ADMIN_USERNAME=admin
ADMIN_TEMP_PASSWORD=change-me-1234
