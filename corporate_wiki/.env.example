DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Публикуете через ngrok (или любой другой туннель/прокси на своём домене)?
# Добавьте его домен сюда — иначе Django отвечает 400 Bad Request на все
# запросы. Домен ngrok меняется при каждом перезапуске, поэтому проще
# один раз указать маску поддомена, например для ngrok-free.app:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app
# Аналогично для отправки форм (например, входа) нужен доверенный источник:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=

SQLITE_PATH=/app/data/db.sqlite3
# Куда manage.py backup_database складывает резервные копии (см. Этап 11).
BACKUP_DIR=/app/data/backups

# Название и брендинг базы знаний — задаётся здесь, а не в коде/шаблонах.
SITE_NAME=Corporate Wiki
SITE_URL=http://localhost:8000

MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_ATTACHMENT_SIZE_MB=20

# "Задай свой вопрос" на странице статьи — отвечает на основе текста
# текущей статьи через OpenAI (запрос уходит только когда действительно
# задан вопрос). Не задан — раздел просто сообщит, что не настроен.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# Используются только командой create_initial_admin (см. Этап 2).
ADMIN_USERNAME=admin
ADMIN_TEMP_PASSWORD=change-me-1234
